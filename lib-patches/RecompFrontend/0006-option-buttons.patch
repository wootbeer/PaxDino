+    static std::unordered_map<std::string, config::OptionButton> option_buttons;
+
+    void config::add_option_button(const std::string &option_id, const std::string &label, std::function<void()> callback) {
+        option_buttons[option_id] = OptionButton{ label, std::move(callback) };
+    }
+
+    const config::OptionButton *config::get_option_button(const std::string &option_id) {
+        auto it = option_buttons.find(option_id);
