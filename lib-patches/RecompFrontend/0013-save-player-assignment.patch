+
+// The connected controllers, in SDL's device order.
+static std::vector<SDL_GameController*> connected_controllers() {
+    std::vector<SDL_GameController*> controllers;
+    for (int i = 0; i < SDL_NumJoysticks(); i++) {
+        if (!SDL_IsGameController(i)) {
+            continue;
+        }
+        SDL_GameController* controller = SDL_GameControllerFromInstanceID(SDL_JoystickGetDeviceInstanceID(i));
+        if (controller != nullptr) {
+            controllers.push_back(controller);
+        }
+    }
+    return controllers;
+}
+
+static std::string controller_guid(SDL_GameController* controller) {
+    char text[64] = {};
+    SDL_JoystickGetGUIDString(SDL_JoystickGetGUID(SDL_GameControllerGetJoystick(controller)), text, sizeof(text));
+    return text;
+}
+
+std::vector<std::string> playerassignment::describe() {
+    std::vector<std::string> out;
+    std::vector<SDL_GameController*> controllers = connected_controllers();
+    for (size_t i = 0; i < PlayerState.players.get_count(); i++) {
+        const Player& player = PlayerState.players[i];
+        if (player.controller == nullptr) {
+            out.push_back("keyboard");
+            continue;
+        }
+        std::string guid = controller_guid(player.controller);
+        int n = 0;
+        for (SDL_GameController* controller : controllers) {
+            if (controller == player.controller) {
+                break;
+            }
+            if (controller_guid(controller) == guid) {
+                n++;
+            }
+        }
+        out.push_back("pad:" + guid + ":" + std::to_string(n));
+    }
+    return out;
+}
+
+bool playerassignment::restore(const std::vector<std::string>& players) {
+    if (players.empty() || players.size() > PlayerState.max_players) {
+        return false;
+    }
+    std::vector<SDL_GameController*> controllers = connected_controllers();
+    PlayerArray restored{};
+    for (const std::string& entry : players) {
+        if (entry == "keyboard") {
+            restored.add_keyboard_player();
+            continue;
+        }
+        size_t colon = entry.rfind(':');
+        if (entry.rfind("pad:", 0) != 0 || colon <= 4) {
+            return false;
+        }
+        std::string guid = entry.substr(4, colon - 4);
+        int n = std::atoi(entry.c_str() + colon + 1);
+        SDL_GameController* found = nullptr;
+        for (SDL_GameController* controller : controllers) {
+            if (controller_guid(controller) == guid && n-- == 0) {
+                found = controller;
+                break;
+            }
+        }
+        if (found == nullptr) {
+            return false;
+        }
+        restored.add_controller_player(found);
+    }
+    PlayerState.players = restored;
+    use_assigned_players();
+    return true;
+}
+
