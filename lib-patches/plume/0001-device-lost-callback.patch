+    // The device lost (removed, hung or reset): told once, through
+    // deviceLostCallback, with the device's removal reason.
+    static void checkDeviceLost(ID3D12Device *device, HRESULT res) {
+        if ((res != DXGI_ERROR_DEVICE_REMOVED) && (res != DXGI_ERROR_DEVICE_HUNG) && (res != DXGI_ERROR_DEVICE_RESET) &&
+            (res != DXGI_ERROR_DRIVER_INTERNAL_ERROR)) {
+            return;
+        }
+
+        static std::atomic<bool> told = false;
+        if ((deviceLostCallback != nullptr) && !told.exchange(true)) {
+            const HRESULT reason = (device != nullptr) ? device->GetDeviceRemovedReason() : res;
+            deviceLostCallback("D3D12", uint32_t(res), uint32_t(reason));
+        }
+    }
+
     static void setObjectName(ID3D12Object *object, const std::string &name) {
         const std::wstring wideCharName = Utf8ToUtf16(name);
         object->SetName(wideCharName.c_str());
