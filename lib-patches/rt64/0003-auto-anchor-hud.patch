+    void RDP::setAutoAnchor(uint8_t mode) {
+        extended.autoAnchor = mode;
+    }
+
+    // Anchors a HUD rectangle to the nearest screen edge when automatic
+    // anchoring is on and the rectangle has no alignment of its own:
+    // rectangles in the top quarter go to the side they're on, the bottom
+    // quarter's to the left (or right, past 60% of the width), and anything
+    // in between (crosshair, messages, menus) stays centred. Right-anchored
+    // coordinates are relative to the right edge.
+    ExtendedAlignment RDP::autoAnchorAlignment(int32_t ulx, int32_t uly, int32_t lrx, int32_t lry, const ExtendedAlignment &extAlignment) const {
+        if ((extended.autoAnchor == 0) || (extAlignment.leftOrigin != G_EX_ORIGIN_NONE) || (extAlignment.rightOrigin != G_EX_ORIGIN_NONE) || (colorImage.width == 0)) {
+            return extAlignment;
+        }
+
+        const int32_t width = int32_t(colorImage.width) * 4;
+        const int32_t height = (width * 3) / 4;
+        const int32_t cx = (ulx + lrx) / 2;
+        const int32_t cy = (uly + lry) / 2;
+        uint16_t origin = G_EX_ORIGIN_NONE;
+        if (cy < height / 4) {
+            origin = (cx < width / 2) ? G_EX_ORIGIN_LEFT : G_EX_ORIGIN_RIGHT;
+        }
+        else if (cy > (height * 3) / 4) {
+            origin = (cx < (width * 3) / 5) ? G_EX_ORIGIN_LEFT : G_EX_ORIGIN_RIGHT;
+        }
+
+        ExtendedAlignment result = extAlignment;
+        if (origin == G_EX_ORIGIN_LEFT) {
+            result.leftOrigin = G_EX_ORIGIN_LEFT;
+            result.rightOrigin = G_EX_ORIGIN_LEFT;
+        }
+        else if (origin == G_EX_ORIGIN_RIGHT) {
+            result.leftOrigin = G_EX_ORIGIN_RIGHT;
+            result.rightOrigin = G_EX_ORIGIN_RIGHT;
+            result.leftOffset -= width;
+            result.rightOffset -= width;
+        }
+        return result;
+    }
+
     void RDP::setScissorAlign(const ExtendedAlignment &extAlignment) {
         extended.global.scissor = extAlignment;
     }
